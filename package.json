{
  "name": "mikumikuar",
  "private": true,
  "version": "1.7.0",
  "scripts": {
    "gen:status": "node scripts/gen-status-index.mjs --reverse",
    "check:status": "node scripts/gen-status-index.mjs --reverse --check",
    "check:docs": "npm run check:status && node scripts/check-doc-drift.mjs && node scripts/check-schema-groups.mjs && node scripts/i18n-check.mjs && node scripts/gen-knowledge-symbols.mjs --check && node scripts/gen-tier.mjs --check && node scripts/gen-docs-index.mjs --check && npm run check:knowgraph && npm run check:ui-entry && npm run check:md-links",
    "check:md-links": "python tests/test_markdown_links.py",
    "check:schema-groups": "node scripts/check-schema-groups.mjs --strict",
    "check:i18n": "node scripts/i18n-check.mjs",
    "dep:graph": "node scripts/gen-dep-graph.mjs",
    "dep:graph:list": "node scripts/gen-dep-graph.mjs --format list",
    "check:circular": "node scripts/check-circular.mjs",
    "gen:funcmap": "node scripts/gen-funcmap.mjs",
    "check:funcmap": "node scripts/gen-funcmap.mjs --check",
    "gen:knowledge-symbols": "node scripts/gen-knowledge-symbols.mjs",
    "gen:tier": "node scripts/gen-tier.mjs",
    "gen:docsindex": "node scripts/gen-docs-index.mjs",
    "check:docsindex": "node scripts/gen-docs-index.mjs --check",
    "gen:knowgraph": "node scripts/gen-knowledge-graph.mjs --file docs/knowledge/graph.md",
    "check:knowgraph": "node scripts/gen-knowledge-graph.mjs --check --file docs/knowledge/graph.md",
    "gen:ui-entry": "node scripts/gen-ui-entry.mjs",
    "check:ui-entry": "node scripts/gen-ui-entry.mjs --check",
    "test:scripts": "node --test scripts/_lib/source-graph.test.mjs",
    "codemod": "cd frontend && node ../scripts/codemod.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test": "cd frontend && npm test",
    "build": "cd frontend && npm run build",
    "dev": "cd frontend && npx vite --port 9245 --strictPort",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:linux": "bash scripts/build-linux.sh",
    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Arch arm64",
    "build:android:release": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Arch arm64 -Production"
  }
}
