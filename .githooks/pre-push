#!/bin/sh
# MikuMikuAR pre-push — 本地质量门禁
# 全部 stdout → stderr，避免 Windows git hook 管道断裂
# 安装: git config core.hooksPath .githooks
# 跳过: git push --no-verify（不推荐）
# 设计原则：
#   - 可自动生成的（status/funcmap/baseline）→ 自动修复 + warn，不阻断
#   - 需人工介入的（lint error/测试失败/文档漂移 ERROR）→ 阻断
#
exec 1>&2
set -e
ROOT="$(git rev-parse --show-toplevel)"

# ── 环境修正（Windows 多 git/node 环境兼容） ──
# 问题：GitHub Desktop / TRAE 等会注入自己的 node 目录到 PATH 前，
# 但其 bash 版 npm shim 依赖 sed/dirname 等 Unix 工具，hook 用的 sh 环境不全时失败。
# 修复：把系统 Node + 系统 Git 的 Unix 工具放到 PATH 最前，确保 npm/node 正确解析。
# 检测：若修正后 npm 仍不可用，warn 跳过 lint/test（环境问题不该阻断代码推送）。
NPM_AVAILABLE=true
command -v npm >/dev/null 2>&1 || {
  # 尝试修正 PATH：系统 Node + 系统 Git Unix 工具
  SYS_NODE="/c/Program Files/nodejs"
  SYS_GIT_USR_BIN="/c/Program Files/Git/usr/bin"
  [ -d "$SYS_NODE" ] && PATH="$SYS_NODE:$PATH"
  [ -d "$SYS_GIT_USR_BIN" ] && PATH="$SYS_GIT_USR_BIN:$PATH"
  export PATH
  command -v npm >/dev/null 2>&1 || {
    echo "⚠️  hook 环境中 npm 不可用（PATH 异常）。lint/test 将被跳过。"
    echo "   手动推送: 用 PowerShell/CMD 运行 git push"
    NPM_AVAILABLE=false
  }
}

# ── 结论摘要累积（末尾输出，避免 AI 只读最后几行漏掉中间 WARN/INFO） ──
SUMMARY_FIXED=""
SUMMARY_CHECKS=""
note_fixed() { SUMMARY_FIXED="${SUMMARY_FIXED}${SUMMARY_FIXED:+ · }$1"; }
# 记录每个检查项的最终状态（✅ 通过 / 🔧 自动修复 / ⏭️ 跳过），末尾摘要统一展示
note_check() { SUMMARY_CHECKS="${SUMMARY_CHECKS}
  $1"; }

# ── 解析推送范围（从 stdin 读取 pre-push refs，支持多 ref 推送） ──
# 输入格式：<local-ref> <local-sha> <remote-ref> <remote-sha>
# 策略：对所有非删除 ref 取变更并集，RANGE 用空格分隔供后续 grep 遍历
RANGES=""
while read _local_ref local_sha _remote_ref remote_sha; do
  # 跳过删除推送（local_sha 为零）
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支推送：用 merge-base 取与对应远程分支的公共祖先
    # 从 local_ref 解析分支名（refs/heads/<branch> → <branch>）
    branch="${_local_ref#refs/heads/}"
    remote_ref="origin/$branch"
    MERGE_BASE="$(git merge-base HEAD "$remote_ref" 2>/dev/null || true)"
    # 回退到 origin/main（兼容首次推送无远程分支的场景）
    if [ -z "$MERGE_BASE" ]; then
      MERGE_BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)"
    fi
    if [ -n "$MERGE_BASE" ]; then
      RANGES="$RANGES $MERGE_BASE..$local_sha"
    fi
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

# ── 获取变更文件清单（合并所有 RANGES） ──
CHANGED=""
if [ -n "$RANGES" ]; then
  for r in $RANGES; do
    CHANGED="$CHANGED
$(git diff --name-only "$r" 2>/dev/null || true)"
  done
  # 去重 + 去空行
  CHANGED="$(echo "$CHANGED" | sort -u | sed '/^$/d')"
fi

# ── 判断变更域 ──
GO_CHANGED=false
TS_CHANGED=false
DOCS_ONLY=false

if [ -n "$CHANGED" ]; then
  if echo "$CHANGED" | grep -qE '\.go$'; then
    if echo "$CHANGED" | grep -vE '(build/|_test\.go$)' | grep -qE '\.go$'; then
      GO_CHANGED=true
    fi
  fi
  if echo "$CHANGED" | grep -qE '\.(ts|tsx|js|jsx)$'; then
    TS_CHANGED=true
  fi
  if echo "$CHANGED" | grep -qvE '^(docs/|.*\.md$|AGENTS\.md)'; then
    DOCS_ONLY=false
  else
    DOCS_ONLY=true
  fi
fi

# ── P6: bindings 同步性（Go 变动时检查；不可自动修复） ──
# 实跑 generate:bindings 对比工作区：
#   - 生成结果与当前一致（含"Go 改了但 bindings 内容恰好没变"的合法场景）→ 放行
#   - 生成结果有 diff（bindings 过期）→ 阻断，提示用户 amend
if [ "$GO_CHANGED" = "true" ]; then
  echo "[pre-push] check:bindings（实跑 generate:bindings 验证同步性）"
  if [ ! -d "$ROOT/frontend/bindings" ] || [ -z "$(ls -A "$ROOT/frontend/bindings" 2>/dev/null)" ]; then
    echo "❌ frontend/bindings/ 为空。请运行: cd frontend && npm run generate:bindings"
    exit 1
  fi
  if ! (cd "$ROOT/frontend" && npm run generate:bindings >/dev/null 2>&1); then
    echo "❌ generate:bindings 执行失败。请检查 Go 代码是否能编译。"
    echo "   手动运行: cd frontend && npm run generate:bindings 查看错误"
    exit 1
  fi
  if ! git diff --quiet -- frontend/bindings/ 2>/dev/null; then
    echo "❌ Go 文件已变更但 frontend/bindings/ 未同步。"
    echo "   hook 已运行 generate:bindings 生成最新版本，请检查 diff 后 amend："
    echo "     git add frontend/bindings/ && git commit --amend --no-edit"
    exit 1
  fi
  note_check "✅ check:bindings 同步性"
fi

# ── check:status（可自动修复，amend 进当前 commit） ──
# 成功静默（末尾摘要已聚合状态），仅未同步/修复时输出
echo "[pre-push] check:status"
cd "$ROOT" && node scripts/gen-status-index.mjs --reverse --check >/dev/null 2>&1 || {
  echo "⚠️  status.md 未同步，自动修复中..."
  cd "$ROOT" && node scripts/gen-status-index.mjs --reverse
  git add docs/status.md 2>/dev/null || true
  git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新 docs/status.md 并 amend 进当前 commit。" || echo "⚠️  已 stage docs/status.md（无 HEAD 可 amend，请手动 commit）。"
  note_fixed "status.md 已同步"
}
note_check "✅ check:status 索引同步"

# ── check:funcmap（可自动修复，amend 进当前 commit） ──
# 成功静默（末尾摘要已聚合状态），仅未同步/修复时输出
echo "[pre-push] check:funcmap"
cd "$ROOT" && node scripts/gen-funcmap.mjs --check >/dev/null 2>&1 || {
  echo "⚠️  function-map.md 未同步，自动修复中..."
  cd "$ROOT" && node scripts/gen-funcmap.mjs
  git add docs/function-map.md 2>/dev/null || true
  git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新 docs/function-map.md 并 amend 进当前 commit。" || echo "⚠️  已 stage docs/function-map.md（无 HEAD 可 amend，请手动 commit）。"
  note_fixed "function-map.md 已同步"
}
note_check "✅ check:funcmap 已同步"

# ── check:docsindex（可自动修复，amend 进当前 commit） ──
# gen-docs-index 生成 5 个分区索引（guide/adr/knowledge/buglog/releases）：
# 新增 ADR/buglog/发版记录后未同步索引 → --check 检出 stale。
# 无条件运行（含 DOCS_ONLY）：纯文档变更恰是最易漏索引的场景
# （2026-08-02 v1.8.0 发版记录漏 index 即实证），与 status/funcmap 同模式。
echo "[pre-push] check:docsindex"
cd "$ROOT" && node scripts/gen-docs-index.mjs --check >/dev/null 2>&1 || {
  echo "⚠️  分区索引（guide/adr/knowledge/buglog/releases）未同步，自动修复中..."
  cd "$ROOT" && node scripts/gen-docs-index.mjs
  git add docs/guide/index.md docs/adr/index.md docs/knowledge/index.md docs/buglog/index.md docs/releases/index.md 2>/dev/null || true
  git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新分区索引并 amend 进当前 commit。" || echo "⚠️  已 stage 分区索引（无 HEAD 可 amend，请手动 commit）。"
  note_fixed "分区索引已同步"
}
note_check "✅ check:docsindex 分区索引同步"

# ── check:guide-gap（菜单面板 ↔ 指南覆盖缺口；人工补写，不可自动修复） ──
# 依赖 menu-map.md（源码生成）与 guide/（手写）：新增菜单面板后 guide 无对应
# 操作页 → 用户找不到入口。guide 是手写叙事文档，无法自动生成 → 缺口即阻断，
# 提示人工补写（与 CI 的 gen-guide-gap --strict 硬门禁对齐）。
echo "[pre-push] check:guide-gap（缺口即阻断）"
if ! cd "$ROOT" && node scripts/gen-guide-gap.mjs --strict >/dev/null 2>&1; then
  echo "❌ 菜单面板存在 guide 覆盖缺口，需人工补写指南页。详情："
  cd "$ROOT" && node scripts/gen-guide-gap.mjs --strict 2>&1 | tail -15
  exit 1
fi
note_check "✅ check:guide-gap（guide 全覆盖）"

# ── check:menumap（可自动修复，amend 进当前 commit） ──
# menu-map.md 由声明式菜单 schema 生成：新增/改名面板后未同步 → --check 检出 stale。
echo "[pre-push] check:menumap"
cd "$ROOT" && node scripts/gen-menu-map.mjs --check >/dev/null 2>&1 || {
  echo "⚠️  menu-map.md 未同步，自动修复中..."
  cd "$ROOT" && node scripts/gen-menu-map.mjs
  git add docs/knowledge/menu-map.md 2>/dev/null || true
  git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新 menu-map.md 并 amend 进当前 commit。" || echo "⚠️  已 stage menu-map.md（无 HEAD 可 amend，请手动 commit）。"
  note_fixed "menu-map.md 已同步"
}
note_check "✅ check:menumap 同步"

# ── lint（仅 TS/JS 变更时；不可自动修复） ──
# 纯 Go / 纯文档变更不触发前端 lint（Go 有 go vet，文档无 lint 必要）
# npm 不可用时跳过（环境问题不该阻断代码推送）
# 警告多为结构性指标（complexity/max-lines 等，无 --fix），成功时只输出计数摘要，避免刷屏
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  echo "[pre-push] lint（0 errors 放行）"
  LINT_OUT="$(cd "$ROOT/frontend" && npm run lint 2>&1)" || {
    printf '%s\n' "$LINT_OUT" | tail -40
    echo "❌ ESLint 检出 error。修复: npm run lint 查看详情"
    exit 1
  }
  WARN_COUNT="$(printf '%s\n' "$LINT_OUT" | grep -oE '[0-9]+ warnings?' | tail -1 | grep -oE '[0-9]+')"
  [ -z "$WARN_COUNT" ] && WARN_COUNT=0
  if [ "$WARN_COUNT" -gt 0 ] 2>/dev/null; then
    echo "⚠️  lint 通过（${WARN_COUNT} 个结构性 warnings，不阻断）"
  fi
  note_check "✅ lint"
else
  echo "[pre-push] lint（跳过：未涉及 TS/JS 源码 或 npm 不可用）"
  note_check "⏭️ lint（未涉及 TS 或 npm 不可用）"
fi

# ── test:coverage（仅 TS/JS 变更时；不可自动修复） ──
# 纯 Go 变更有 Go 测试覆盖，纯文档变更无逻辑可测，均跳过前端测试
# npm 不可用时跳过；成功静默（coverage summary 大表由 CI 门禁兜底），失败打印详情
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  echo "[pre-push] test:coverage（门禁: lines≥35% functions≥30%）"
  cd "$ROOT/frontend" && npm run test:coverage >/dev/null 2>&1 || {
    echo "❌ 测试失败或覆盖率低于阈值。修复: npm run test:coverage 查看详情"
    exit 1
  }
  note_check "✅ test:coverage"
else
  echo "[pre-push] test:coverage（跳过：纯 Go / 纯文档变更 / npm 不可用）"
  note_check "⏭️ test:coverage（未涉及 TS 或 npm 不可用）"
fi

# ── P7: deadcode 基线（可自动修复，amend 进当前 commit） ──
# 成功静默（15 行对比表只在未回退时展示数字，摘要已含结论），超基线才展开修复
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  echo "[pre-push] deadcode（基线治理：knip + jscpd）"
  cd "$ROOT/frontend" && node ../scripts/check-deadcode-baseline.mjs >/dev/null 2>&1 || {
    echo "⚠️  死代码/重复代码超过基线，自动更新基线..."
    node ../scripts/check-deadcode-baseline.mjs --update
    git add ../docs/.deadcode-baseline.json 2>/dev/null || true
    git commit --amend --no-edit 2>/dev/null && echo "⚠️  deadcode 基线已更新并 amend 进当前 commit。" || echo "⚠️  deadcode 基线已 stage（无 HEAD 可 amend，请手动 commit）。"
    note_fixed "deadcode 基线已更新"
    echo "⚠️  如有新增死代码，考虑后续清理。"
  }
  note_check "✅ deadcode 基线"
elif [ "$TS_CHANGED" = "true" ]; then
  echo "[pre-push] deadcode（跳过：npm 不可用）"
  note_check "⏭️ deadcode（npm 不可用）"
fi

# ── check:docs（ERROR 阻断；INFO 基线自动修复 + amend） ──
# 漂移分级：ERROR（架构树/ADR 失效等）必须人工修复；INFO（符号覆盖率缺口）可自动更新基线
# 成功静默（24 行报告冗余，摘要已聚合 INFO；ERROR 详情在失败分支展开）
run_check_docs() {
  cd "$ROOT" && node scripts/check-doc-drift.mjs --baseline >/dev/null 2>&1
}
if [ "$DOCS_ONLY" = "false" ]; then
  echo "[pre-push] check:docs（ERROR 阻断；INFO 基线自动修复）"
  # AI 可读快照：全量 JSON（含 ERROR/INFO）+ 下一步建议简报（均非阻断）
  cd "$ROOT" && node scripts/check-doc-drift.mjs --json > docs/.doc-check-last.json 2>/dev/null || true
  cd "$ROOT" && node scripts/doc-check-next-steps.mjs 2>/dev/null || true
  if ! run_check_docs; then
    # 先尝试自动更新 INFO 基线
    if cd "$ROOT" && node scripts/check-doc-drift.mjs --baseline-update 2>/dev/null; then
      echo "⚠️  INFO 基线已自动更新，amend 进当前 commit..."
      git add docs/.doc-check-baseline.json 2>/dev/null || true
      git commit --amend --no-edit 2>/dev/null && echo "⚠️  已 amend。" || echo "⚠️  已 stage（无 HEAD 可 amend）。"
      note_fixed "doc 漂移 INFO 基线已更新"
      # 重新跑确认是否只剩 ERROR
      if ! run_check_docs; then
        echo "❌ 文档漂移 ERROR，需人工修复。详情："
        cd "$ROOT" && node scripts/check-doc-drift.mjs --baseline 2>&1 | tail -30
        exit 1
      fi
    else
      echo "❌ 文档漂移 ERROR，需人工修复。详情："
      cd "$ROOT" && node scripts/check-doc-drift.mjs --baseline 2>&1 | tail -30
      exit 1
    fi
  fi
  note_check "✅ check:docs 漂移"
else
  echo "[pre-push] check:docs（跳过：纯文档变更）"
  note_check "⏭️ check:docs（纯文档变更）"
fi

# ── i18n（strict：缺 key / 真漏译即阻断；不可自动修复） ──
# 与 CI 的 `--strict` 对齐：翻译 bundle 缺 key、占位符不一致或 zh-CN 真漏译
# 都是 push 即可发现、当场能改的问题，不必等 CI 红灯。
# 成功静默；失败打印详情（含缺失 key 清单）。
if [ "$NPM_AVAILABLE" = "true" ]; then
  echo "[pre-push] i18n（strict：bundle key 对齐 + 漏译）"
  cd "$ROOT" && node scripts/i18n-check.mjs --strict >/dev/null 2>&1 || {
    echo "❌ i18n 检查失败（缺 key / 占位符不一致 / 漏译）。详情："
    cd "$ROOT" && node scripts/i18n-check.mjs --strict 2>&1 | tail -30
    exit 1
  }
  note_check "✅ i18n"
else
  echo "[pre-push] i18n（跳过：npm 不可用）"
  note_check "⏭️ i18n（npm 不可用）"
fi

# ── check:md-links（Python 契约测试；不可自动修复） ──
# 校验 docs/AGENTS.md 内部 Markdown 链接有效性（CI 同脚本同步执行）。
# 无条件运行：链接有效性随文档变更而变，DOCS_ONLY 时 check:docs 跳过但本项不跳；
# 脚本崩溃（如 embedded null byte）即阻断，broken 链接仅 INFO 不阻断。
PYTHON_AVAILABLE=true
command -v python >/dev/null 2>&1 || {
  echo "⚠️  hook 环境中 python 不可用，check:md-links 跳过。"
  PYTHON_AVAILABLE=false
}
if [ "$PYTHON_AVAILABLE" = "true" ]; then
  echo "[pre-push] check:md-links"
  cd "$ROOT" && python tests/test_markdown_links.py >/dev/null 2>&1 || {
    echo "❌ Markdown 链接契约测试执行失败（脚本崩溃）。"
    echo "   手动运行: python tests/test_markdown_links.py 查看详情"
    exit 1
  }
  note_check "✅ check:md-links"
else
  echo "[pre-push] check:md-links（跳过：python 不可用）"
  note_check "⏭️ check:md-links（python 不可用）"
fi

# ── 结论摘要（AI 友好：末尾聚合关键结果，避免只读最后几行漏掉中间 WARN/INFO） ──
echo ""
echo "════════ [pre-push] 结论摘要 ════════"
echo "  检查项:"
if [ -n "$SUMMARY_CHECKS" ]; then
  echo "$SUMMARY_CHECKS"
else
  echo "    （无检查项记录）"
fi
if [ -n "$SUMMARY_FIXED" ]; then
  echo "  🔧 自动修复并 amend: $SUMMARY_FIXED"
fi
if [ -f "$ROOT/docs/.doc-check-last.json" ] && command -v node >/dev/null 2>&1; then
  node -e '
    const fs = require("fs");
    const j = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const notes = [];
    if (j.errors && j.errors.length) notes.push(`❌ ERROR 漂移 ${j.errors.length} 条（阻断，见上方详情）`);
    if (j.reverse && j.reverse.total > 0) notes.push(`⚠️ 知识卡未覆盖源文件 ${j.reverse.total} 个: ${j.reverse.files.join(", ")}`);
    if (j.coverage && j.coverage.undocumented > 0) notes.push(`ℹ️ 符号 0% 未文档化模块 ${j.coverage.undocumented} 个`);
    if (j.agentsWarns && j.agentsWarns.length) notes.push(`⚠️ AGENTS 手写事实索引 ${j.agentsWarns.length} 项`);
    if (notes.length) console.log(notes.join("\n"));
  ' "$ROOT/docs/.doc-check-last.json" 2>/dev/null || true
fi
echo "════════════════════════════════════"
echo "[pre-push] ✅ 全部通过"
