#!/bin/sh
# MikuMikuAR pre-push — 本地质量门禁
# 全部 stdout → stderr，避免 Windows git hook 管道断裂
# 安装: git config core.hooksPath .githooks
# 跳过: git push --no-verify（不推荐）
# 设计原则（2026-10-23 起以 CI 为唯一权威）：
#   留在本地的检查必须满足其一，否则归 CI：
#     ① 能自动修（gen 生成物、INFO 基线）
#     ② 秒级且能精确指路（lint/tsc/i18n/layering/circular/doc-drift）
#     ③ 能省一轮 CI 往返（vitest --changed）
# 当前 10 项：lint:changed · check:layering · check:circular · check:coupling ·
#   check:dep-docs · check:babylon-lib · tsc · vitest --changed(+diff-coverage) · check:docs · i18n
# 本文件不做的事（已移交 CI，别再加回来）：
#   - 文档生成物 6 项（status/funcmap/docsindex/novelindex/guide-gap/menumap）
#     → pre-commit 生成 + CI「Generated docs sync check」19 条 --check
#   - bindings 同步性 → CI「Bindings freshness gate」（wails3 generate bindings -ts -i -d）
#   - md 断链（check:md-links / link:check）→ CI config-syntax job
#   - deadcode → CI deadcode-baseline job
#
exec 1>&2
set -e
ROOT="$(git rev-parse --show-toplevel)"

# ── 环境修正（Windows 多 git/node 环境兼容） ──
# 问题：GitHub Desktop / TRAE 等会注入自己的 node 目录到 PATH 前，
# 但其 bash 版 npm shim 依赖 sed/dirname 等 Unix 工具，hook 用的 sh 环境不全时失败。
# 修复：把系统 Node + 系统 Git 的 Unix 工具放到 PATH 最前，确保 npm/node 正确解析。
# 检测：若修正后 npm 仍不可用，warn 跳过 lint/test（环境问题不该阻断代码推送）。
NPM_AVAILABLE=true
NPM_SKIP_REASON=""
# 用一个能真实执行的函数验证 npm 可用（避免 PATH 里有坏 shim 却 command -v 命中）
_npm_usable() {
  command -v npm >/dev/null 2>&1 && npm --version >/dev/null 2>&1
}
if ! _npm_usable; then
  # 尝试修正 PATH：系统 Node + 系统 Git Unix 工具（兼容非 C 盘 / nvm / fnm 常见安装点）
  for CAND in \
    "/c/Program Files/nodejs" \
    "/c/Program Files (x86)/nodejs" \
    "/c/Users/$USER/AppData/Roaming/nvm/current" \
    "/c/Users/$USER/.fnm/current" \
    "/usr/local/bin" \
    "/opt/homebrew/bin"; do
    [ -d "$CAND" ] && PATH="$CAND:$PATH"
  done
  export PATH
  if ! _npm_usable; then
    NPM_AVAILABLE=false
    NPM_SKIP_REASON="hook 环境中 npm 不可用（PATH 异常；已尝试常见安装点仍失败）"
  fi
fi

# ── 结论摘要累积（末尾输出，避免 AI 只读最后几行漏掉中间 WARN/INFO） ──
SUMMARY_FIXED=""
SUMMARY_CHECKS=""
SUMMARY_FAILURES=""
note_fixed() { SUMMARY_FIXED="${SUMMARY_FIXED}${SUMMARY_FIXED:+ · }$1"; }
# 记录每个检查项的最终状态（✅ 通过 / 🔧 自动修复 / ⏭️ 跳过 / ❌ 失败），末尾摘要统一展示
note_check() { SUMMARY_CHECKS="${SUMMARY_CHECKS}
  $1"; }
# 收集失败项（不立即 exit，等所有检查跑完再统一报告）
collect_fail() {
  SUMMARY_FAILURES="${SUMMARY_FAILURES}${SUMMARY_FAILURES:+
}❌ $1"
}
# ── 并行执行辅助 ───────────────────────────────────────────────
# 在 set -e 下安全并发：用 & 启动后台任务，wait || true 收集退出码。
# 策略：将完全独立的 node 命令并行化；shell 逻辑（条件判断）保持串行。
# 结果传递：并行组通过临时文件写入 _par_note_check/_par_collect_fail/_par_note_fixed，
#           主进程在 wait 后由 _par_merge_dir 读回。
# 并行子进程中使用这些函数记录结果
_par_note_check() { echo "CHECK|$1" >> "$_PAR_DIR/checks"; }
_par_collect_fail() { echo "FAIL|${1}${2:+: $2}" >> "$_PAR_DIR/fails"; }
_par_note_fixed() { echo "FIXED|$1" >> "$_PAR_DIR/fixed"; }
# 合并指定 _par 目录的结果（组 C 并行结束后调用）
_par_merge_dir() {
  local _d="$1"
  [ -f "$_d/checks" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "CHECK" ] && note_check "$_v"
  done < "$_d/checks"
  [ -f "$_d/fails" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "FAIL" ] && collect_fail "$_v"
  done < "$_d/fails"
  [ -f "$_d/fixed" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "FIXED" ] && note_fixed "$_v"
  done < "$_d/fixed"
}
_parallel_wait() {
  local rc=0
  for _pid in "$@"; do
    wait $_pid || rc=$((rc + 1))
  done
  return $rc
}

# 最终结论：所有检查跑完后统一报告，避免 AI 只看到第一个错误
finalize_results() {
  echo ""
  echo "════════ [pre-push] 结论摘要 ════════"
  echo "  检查项:"
  if [ -n "$SUMMARY_CHECKS" ]; then
    echo "$SUMMARY_CHECKS"
  else
    echo "    （无检查项记录）"
  fi
  if [ -n "$SUMMARY_FIXED" ]; then
    echo "  🔧 自动修复并 stage: $SUMMARY_FIXED"
  fi
  if [ -n "$SUMMARY_FAILURES" ]; then
    echo ""
    echo "  ❌ 失败项:"
    echo "$SUMMARY_FAILURES"
    echo ""
    echo "  下一步: 修复上方失败项后重推（完整输出见上方详情）"
    echo "════════════════════════════════════"
    exit 1
  fi
  echo "════════════════════════════════════"
  echo "[pre-push] ✅ 全部通过"
}

# ── 解析推送范围（从 stdin 读取 pre-push refs，支持多 ref 推送） ──
# 输入格式：<local-ref> <local-sha> <remote-ref> <remote-sha>
# 策略：对所有非删除 ref 取变更并集，RANGE 用空格分隔供后续 grep 遍历
RANGES=""
while read _local_ref local_sha _remote_ref remote_sha; do
  # 跳过删除推送（local_sha 为零）
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支推送：用 merge-base 取与对应远程分支的公共祖先
    # 从 local_ref 解析分支名（refs/heads/<branch> → <branch>）
    branch="${_local_ref#refs/heads/}"
    remote_ref="origin/$branch"
    MERGE_BASE="$(git merge-base HEAD "$remote_ref" 2>/dev/null || true)"
    # 回退到 origin/main（兼容首次推送无远程分支的场景）
    if [ -z "$MERGE_BASE" ]; then
      MERGE_BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)"
    fi
    if [ -n "$MERGE_BASE" ]; then
      RANGES="$RANGES $MERGE_BASE..$local_sha"
    fi
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

# ── 获取变更文件清单（合并所有 RANGES） ──
CHANGED=""
if [ -n "$RANGES" ]; then
  for r in $RANGES; do
    CHANGED="$CHANGED
$(git diff --name-only "$r" 2>/dev/null || true)"
  done
  # 去重 + 去空行
  CHANGED="$(echo "$CHANGED" | sort -u | sed '/^$/d')"
fi

# ── 未提交改动提示：diff-coverage 基于 --changed（已提交范围），
# 未提交 TS 改动不在其内，会导致 coverage 产物缺失 → 误报「未找到覆盖率文件」。
# 此处醒目提示，避免误判为代码问题（主模型曾因此误停）。
UNCOMMITTED_TS="$(git diff --name-only HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)"
if [ -n "$UNCOMMITTED_TS" ]; then
  echo "[pre-push] ⚠️  检测到未提交的 TS/JS 改动（${UNCOMMITTED_TS}），diff-coverage 仅审计已 commit 范围。"
  echo "           若门禁报「未找到覆盖率文件」，多为未提交导致，请先 commit 改动再 push。"
fi

# ── 兜底：RANGES 为空（本地已与远端同步）但有未提交改动时，
# 仍纳入工作区 diff，避免「改了 TS 没 commit 就 push」场景下 hook 静默全过。
# （注：此时 git push 本身会因 nothing to push 失败，此处仅让提示更友好、检查更真实）
if [ -z "$CHANGED" ]; then
  CHANGED="$(git diff --name-only HEAD 2>/dev/null || true)"
fi

# ── 缓存工具函数（基于 domain-map.mjs）────────────────────────
# 用法: cache_lookup <domain> <files...> → 输出 "hit" 或 "miss"
# 命中时自动跳过对应检查并输出提示
cache_lookup() {
  local domain="$1"
  shift
  local files="$@"
  
  # 生成缓存键
  local cache_key
  cache_key="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-key "$domain" $files 2>/dev/null)" || return 1
  
  # 生成缓存路径
  local cache_file
  cache_file="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$cache_key" 2>/dev/null)" || return 1
  
  # 检查缓存文件是否存在且未过期（24h TTL 由脚本内部管理）
  if [ -f "$cache_file" ]; then
    echo "hit"
    return 0
  else
    echo "miss"
    return 0
  fi
}

# 写入缓存（检查成功后调用）
cache_write() {
  local domain="$1"
  local files="$2"
  local result="$3"
  
  local cache_key
  cache_key="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-key "$domain" $files 2>/dev/null)" || return 1
  
  local cache_file
  cache_file="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$cache_key" 2>/dev/null)" || return 1
  
  # 写入缓存（仅成功结果缓存，失败不缓存以便重试）
  if [ "$result" = "pass" ]; then
    cd "$ROOT" && node --input-type=module -e "
      import { writeCache } from './scripts/domain-map.mjs';
      writeCache('$cache_key', '$result');
    " 2>/dev/null || true
  fi
}

# ── 判断变更域（粗粒度：向后兼容 GO_CHANGED / TS_CHANGED / DOCS_ONLY）──
# 同时调用 domain-map.mjs 获取细粒度分类 JSON（DOMAINS），供 Phase 2 分流决策使用。
GO_CHANGED=false
TS_CHANGED=false
DOCS_ONLY=false

if [ -n "$CHANGED" ]; then
  if echo "$CHANGED" | grep -qE '\.go$'; then
    if echo "$CHANGED" | grep -vE '(build/|_test\.go$)' | grep -qE '\.go$'; then
      GO_CHANGED=true
    fi
  fi
  if echo "$CHANGED" | grep -qE '\.(ts|tsx|js|jsx)$'; then
    TS_CHANGED=true
  fi
  if echo "$CHANGED" | grep -qvE '^(docs/|.*\.md$|AGENTS\.md)'; then
    DOCS_ONLY=false
  else
    DOCS_ONLY=true
  fi
fi

# ── 细粒度领域分流（已移除） ──
# [2026-10-23] 这一段（DOMAINS + _dm_bool + DOM_*）只服务于「文档生成物检查」的
# 分组决策，该组检查已移交 pre-commit（生成）与 CI（--check 兜底），故整段删除。
# 粗粒度的 GO_CHANGED / TS_CHANGED / DOCS_ONLY 仍在上方，lint / tsc / vitest / check:docs 继续使用。

# ── 纯 infra 变更快速放行（.github/ 或 *.yml） ──
# [2026-08-12] 改 CI 工作流/*.yml 不碰源码、文档、ADR，全量生成类门禁
# （funcmap/docsindex/lint/vitest/deadcode 等）无意义且拖慢 push + 吃满单核。
# 此处直接放行，由 push 后 CI（scripts-hygiene / lint / test）兜底。
# 注：仅当变更全部落在 .github/ 或 .yml/.yaml 时短路；改动任一源码/文档仍走全量。
INFRA_ONLY=false
if [ -n "$CHANGED" ]; then
  if echo "$CHANGED" | grep -qvE '^(\.github/|.*\.(yml|yaml)$)'; then
    INFRA_ONLY=false
  else
    INFRA_ONLY=true
  fi
fi
if [ "$INFRA_ONLY" = "true" ]; then
  echo ""
  echo "════════ [pre-push] 结论摘要 ════════"
  echo "  纯 GitHub Actions / YAML 配置变更，跳过源码与文档门禁（CI 兜底）"
  echo "════════════════════════════════════"
  echo "[pre-push] ✅ 全部通过"
  exit 0
fi

# ── bindings 同步性（已移交 CI） ──
# [2026-10-23] CI 的「Bindings freshness gate」（ci.yml:271）跑
#   wails3 generate bindings -ts -i -d frontend/bindings ./... && git diff --exit-code
# 比这里的 `npm run generate:bindings` 更权威（多 -i/-d 两个参数），
# 本地再跑一遍只是两套实现漂移的开销；且本地提示语要求 --amend，
# 与「不恢复 amend」的约定相抵。本地需要时手动: cd frontend && npm run generate:bindings

# ── 文档生成物检查（已移交 pre-commit + CI） ──
# [2026-10-23] status/funcmap/docsindex/novelindex/guide-gap/menumap 这六项留在
# pre-push 是第三重保险：pre-commit 已经跑同一批 gen 脚本生成并 stage，
# CI 的「Generated docs sync check」再跑 19 条 --check 兜底。这里再查一遍只增加
# 维护面（六个函数各带一套 --check + 自动修复 + git add 分支），不增加保障。
# 本地需要时手动: npm run check:docs

# ── lint（仅 TS/JS 变更时；增量扫描加速 + 缓存） ──
# 纯 Go / 纯文档变更不触发前端 lint（Go 有 go vet，文档无 lint 必要）
# npm 不可用时跳过（环境问题不该阻断代码推送）
# 增量扫描：只查变更文件（~2-3s vs 全量 ~16s）
# 缓存：同文件组合命中则跳过（24h TTL）
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  # 取变更的 TS/JS 文件列表。
  # [2026-10-23 fix] 旧实现用 $CHANGED_BASE，而 CHANGED_BASE 在本行之后（vitest 段）
  # 才定义 → 此处恒为空，断言退化成「工作区 vs HEAD」，已提交的变更永远不触发 lint，
  # 是个静默假门禁。改用上方已算好的 CHANGED 并集（覆盖所有待推提交）。
  CHANGED_TS_FILES="$(printf '%s\n' "$CHANGED" | grep -E '\.(ts|tsx|js|jsx)$' || true)"
  if [ -n "$CHANGED_TS_FILES" ]; then
    # 检查缓存
    _CACHE_STATUS="$(cache_lookup "lint" $CHANGED_TS_FILES 2>/dev/null)" || _CACHE_STATUS="miss"
    
    if [ "$_CACHE_STATUS" = "hit" ]; then
      echo "[pre-push] lint:changed（缓存命中，跳过）"
      note_check "⏭️ lint:changed（缓存命中）"
    else
      echo "[pre-push] lint:changed（增量扫描，只查变更文件）"
      # [2026-10-23 fix] 这两处不修，这段就从来跑不出真结果：
      #  1. git diff 给的是仓库根相对路径（frontend/src/…），而这里已 cd 进 frontend/，
      #     直接传给 eslint 会解析成 frontend/frontend/src/… → 全部 "No files matching"。
      #     先剥掉 frontend/ 前缀。
      #  2. Windows 的 npx shim 走 cmd.exe，单条命令行上限约 8K 字符（不是 32K），
      #     200+ 文件一次传入会 "The command line is too long."。按 120 个一批分批跑：
      #     实测 212 个 src 文件 -n 25 → 78s / -n 60 → 39s / -n 120 → 24s
      #     （瓶颈是 npx 每次启动 ~8s，不是 eslint 本身）。
      # [2026-10-23 fix] 只保留 src/ 下的文件，与 CI 的 `npm run lint`（eslint src）同口径。
      # 否则 vite.config.ts 这类仓库根配置也会被传进来，而 eslint 的 TS parser 只对
      # src/** 生效 → 误报 "Parsing error: Unexpected token )"。
      _lint_files="$(printf '%s\n' "$CHANGED_TS_FILES" | sed 's|^frontend/||' | grep -E '^src/' || true)"
      if [ -z "$_lint_files" ]; then
        note_check "⏭️ lint:changed（变更不含 src/ 下文件）"
      fi
      _lint_rc=0
      # -r：空输入不执行命令（无 src/ 变更时不会跑一次裸 eslint）
      LINT_OUT="$(cd "$ROOT/frontend" && printf '%s\n' "$_lint_files" | tr '\n' '\0' | xargs -0 -r -n 120 npx eslint --ext .ts,.tsx,.js,.jsx 2>&1)" || _lint_rc=$?
      if [ "$_lint_rc" -ne 0 ]; then
        printf '%s\n' "$LINT_OUT" | tail -30
        collect_fail "ESLint 检出 error: cd frontend && npx eslint <文件> 修复后重推"
      fi
      WARN_COUNT="$(printf '%s\n' "$LINT_OUT" | grep -oE '[0-9]+ warnings?' | tail -1 | grep -oE '[0-9]+' || true)"
      [ -z "$WARN_COUNT" ] && WARN_COUNT=0
      if [ "$WARN_COUNT" -gt 0 ] 2>/dev/null; then
        echo "⚠️  lint 通过（${WARN_COUNT} 个结构性 warnings，不阻断）"
      fi
      note_check "✅ lint:changed（增量）"
      # 写入缓存（仅成功时）
      cache_write "lint" $CHANGED_TS_FILES "pass"
    fi
  else
    note_check "⏭️ lint:changed（无 TS/JS 变更）"
  fi
else
  if [ "$TS_CHANGED" = "true" ]; then
    note_check "⏭️ lint:changed（npm 不可用 → $NPM_SKIP_REASON）"
  else
    note_check "⏭️ lint:changed（未涉及 TS 或 npm 不可用）"
  fi
fi

# ── check:layering（ADR-242 分层方向；前端源码变更时跑，~0.3s） ──
# 旧实现的跨行正则在 frontend/src/shared/dev-hooks.ts 上灾难性回溯（单线程 >300s），
# 因此分层门禁长期未接入任何检查。改用 scripts/_lib/import-scan.mjs 线性扫描后成本可忽略。
# R1（算法层 → menus）零容忍；R2/R3 超基线即阻断（基线只允许收紧）。
if [ "$TS_CHANGED" = "true" ]; then
  echo "[pre-push] check:layering（ADR-242）"
  if ! (cd "$ROOT" && node scripts/check-layering.mjs >/dev/null 2>&1); then
    echo "❌ 分层反向边超出基线，详情："
    cd "$ROOT" && node scripts/check-layering.mjs 2>&1 | tail -20
    collect_fail "分层检查未通过（ADR-242）: 重构 import 方向，或经评审后 node scripts/check-layering.mjs --update 收紧基线"
  fi
  note_check "✅ check:layering（ADR-242）"
else
  note_check "⏭️ check:layering（无前端源码变更）"
fi

# ── check:circular（ADR-268 环门禁；前端源码变更时跑，~0.35s） ──
# 体检现场：本检查从 ADR-238 起就被文档记作「已挂入 check:docs / pre-push」，实际只挂在
# scripts/diagnose.mjs 的手动诊断任务里。于是 source-graph 的解析缺陷修好后，同一份源码
# 冒出 265 个白名单外环，闸门红着，推送链路却全绿——仪表盘在报数，闸门没关。
# 口径 = 模块加载期依赖（动态 import() 不计入），与 dep:metrics / dep:graph 同一把尺子。
# 白名单判定走节点集合 key（cycleSetKey），最短路径改道不再制造假新增。
if [ "$TS_CHANGED" = "true" ]; then
  echo "[pre-push] check:circular（ADR-268）"
  if ! (cd "$ROOT" && node scripts/check-circular.mjs --strict >/dev/null 2>&1); then
    echo "❌ 循环依赖门禁未通过，详情："
    cd "$ROOT" && node scripts/check-circular.mjs --strict 2>&1 | tail -20
    collect_fail "循环依赖检查未通过（ADR-268）: 修复环或移除依赖方向；确认为已知环请人工编辑 scripts/circular-allowlist.json（只减不增）"
  fi
  note_check "✅ check:circular（ADR-268）"
else
  note_check "⏭️ check:circular（无前端源码变更）"
fi

# ── check:coupling（ADR-270 结构耦合门禁；前端源码变更时跑，~0.4s） ──
# 为什么环门禁不够：模块图已是 DAG（ADR-269 实测真实跨模块 SCC = 0），check:circular
# 只能拦住「反向新增依赖」，**正向新增跨模块依赖会静默通过**——那才是耦合恶化的形态。
# 本检查盯两件事：首次出现的有向模块对（新耦合通道）、文件级 SCC 的覆盖面与最大块。
if [ "$TS_CHANGED" = "true" ]; then
  echo "[pre-push] check:coupling（ADR-270）"
