#!/bin/sh
# MikuMikuAR pre-push — 本地质量门禁
# 全部 stdout → stderr，避免 Windows git hook 管道断裂
# 安装: git config core.hooksPath .githooks
# 跳过: git push --no-verify（不推荐）
# 设计原则：
#   - 可自动生成的（status/funcmap/baseline）→ 自动修复 + warn，不阻断
#   - 需人工介入的（lint error/测试失败/文档漂移 ERROR）→ 阻断
#   - 阻断时输出「结论 + 已通过项 + 下一步」块（fail()），AI 不裸奔
#
exec 1>&2
set -e
ROOT="$(git rev-parse --show-toplevel)"

# ── 环境修正（Windows 多 git/node 环境兼容） ──
# 问题：GitHub Desktop / TRAE 等会注入自己的 node 目录到 PATH 前，
# 但其 bash 版 npm shim 依赖 sed/dirname 等 Unix 工具，hook 用的 sh 环境不全时失败。
# 修复：把系统 Node + 系统 Git 的 Unix 工具放到 PATH 最前，确保 npm/node 正确解析。
# 检测：若修正后 npm 仍不可用，warn 跳过 lint/test（环境问题不该阻断代码推送）。
NPM_AVAILABLE=true
NPM_SKIP_REASON=""
# 用一个能真实执行的函数验证 npm 可用（避免 PATH 里有坏 shim 却 command -v 命中）
_npm_usable() {
  command -v npm >/dev/null 2>&1 && npm --version >/dev/null 2>&1
}
if ! _npm_usable; then
  # 尝试修正 PATH：系统 Node + 系统 Git Unix 工具（兼容非 C 盘 / nvm / fnm 常见安装点）
  for CAND in \
    "/c/Program Files/nodejs" \
    "/c/Program Files (x86)/nodejs" \
    "/c/Users/$USER/AppData/Roaming/nvm/current" \
    "/c/Users/$USER/.fnm/current" \
    "/usr/local/bin" \
    "/opt/homebrew/bin"; do
    [ -d "$CAND" ] && PATH="$CAND:$PATH"
  done
  export PATH
  if ! _npm_usable; then
    NPM_AVAILABLE=false
    NPM_SKIP_REASON="hook 环境中 npm 不可用（PATH 异常；已尝试常见安装点仍失败）"
  fi
fi

# ── 结论摘要累积（末尾输出，避免 AI 只读最后几行漏掉中间 WARN/INFO） ──
SUMMARY_FIXED=""
SUMMARY_CHECKS=""
SUMMARY_FAILURES=""
note_fixed() { SUMMARY_FIXED="${SUMMARY_FIXED}${SUMMARY_FIXED:+ · }$1"; }
# 记录每个检查项的最终状态（✅ 通过 / 🔧 自动修复 / ⏭️ 跳过 / ❌ 失败），末尾摘要统一展示
note_check() { SUMMARY_CHECKS="${SUMMARY_CHECKS}
  $1"; }
# 收集失败项（不立即 exit，等所有检查跑完再统一报告）
collect_fail() {
  SUMMARY_FAILURES="${SUMMARY_FAILURES}${SUMMARY_FAILURES:+
}❌ $1"
}
# ── 并行执行辅助 ───────────────────────────────────────────────
# 在 set -e 下安全并发：用 & 启动后台任务，wait || true 收集退出码。
# 策略：将完全独立的 node/python/npm 命令并行化；shell 逻辑（amend/条件判断）保持串行。
# 结果传递：并行组通过临时文件写入 note_check/collect_fail/note_fixed 调用，
#           主进程在 wait 后读取并应用。
_PAR_DIR=""
_par_init() {
  _PAR_DIR="$(mktemp -d 2>/dev/null || echo "/tmp/pre-push-par.$$")"
  mkdir -p "$_PAR_DIR" 2>/dev/null || true
  : > "$_PAR_DIR/checks"
  : > "$_PAR_DIR/fails"
  : > "$_PAR_DIR/fixed"
}
_par_cleanup() {
  rm -rf "$_PAR_DIR" 2>/dev/null || true
}
# 并行子进程中使用这些函数记录结果
_par_note_check() { echo "CHECK|$1" >> "$_PAR_DIR/checks"; }
_par_collect_fail() { echo "FAIL|$1" >> "$_PAR_DIR/fails"; }
_par_note_fixed() { echo "FIXED|$1" >> "$_PAR_DIR/fixed"; }
# 主进程合并并行组结果
_par_merge() {
  [ -f "$_PAR_DIR/checks" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "CHECK" ] && note_check "$_v"
  done < "$_PAR_DIR/checks"
  [ -f "$_PAR_DIR/fails" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "FAIL" ] && collect_fail "$_v"
  done < "$_PAR_DIR/fails"
  [ -f "$_PAR_DIR/fixed" ] && while IFS='|' read -r _t _v; do
    [ "$_t" = "FIXED" ] && note_fixed "$_v"
  done < "$_PAR_DIR/fixed"
}
_parallel_wait() {
  local rc=0
  for _pid in "$@"; do
    wait $_pid || rc=$((rc + 1))
  done
  return $rc
}

# 最终结论：所有检查跑完后统一报告，避免 AI 只看到第一个错误
finalize_results() {
  echo ""
  echo "════════ [pre-push] 结论摘要 ════════"
  echo "  检查项:"
  if [ -n "$SUMMARY_CHECKS" ]; then
    echo "$SUMMARY_CHECKS"
  else
    echo "    （无检查项记录）"
  fi
  if [ -n "$SUMMARY_FIXED" ]; then
    echo "  🔧 自动修复并 amend: $SUMMARY_FIXED"
  fi
  if [ -n "$SUMMARY_FAILURES" ]; then
    echo ""
    echo "  ❌ 失败项:"
    echo "$SUMMARY_FAILURES"
    echo ""
    echo "  下一步: 修复上方失败项后重推（完整输出见上方详情）"
    echo "════════════════════════════════════"
    exit 1
  fi
  echo "════════════════════════════════════"
  echo "[pre-push] ✅ 全部通过"
}

# ── 解析推送范围（从 stdin 读取 pre-push refs，支持多 ref 推送） ──
# 输入格式：<local-ref> <local-sha> <remote-ref> <remote-sha>
# 策略：对所有非删除 ref 取变更并集，RANGE 用空格分隔供后续 grep 遍历
RANGES=""
while read _local_ref local_sha _remote_ref remote_sha; do
  # 跳过删除推送（local_sha 为零）
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支推送：用 merge-base 取与对应远程分支的公共祖先
    # 从 local_ref 解析分支名（refs/heads/<branch> → <branch>）
    branch="${_local_ref#refs/heads/}"
    remote_ref="origin/$branch"
    MERGE_BASE="$(git merge-base HEAD "$remote_ref" 2>/dev/null || true)"
    # 回退到 origin/main（兼容首次推送无远程分支的场景）
    if [ -z "$MERGE_BASE" ]; then
      MERGE_BASE="$(git merge-base HEAD origin/main 2>/dev/null || true)"
    fi
    if [ -n "$MERGE_BASE" ]; then
      RANGES="$RANGES $MERGE_BASE..$local_sha"
    fi
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

# ── 获取变更文件清单（合并所有 RANGES） ──
CHANGED=""
if [ -n "$RANGES" ]; then
  for r in $RANGES; do
    CHANGED="$CHANGED
$(git diff --name-only "$r" 2>/dev/null || true)"
  done
  # 去重 + 去空行
  CHANGED="$(echo "$CHANGED" | sort -u | sed '/^$/d')"
fi

# ── 未提交改动提示：diff-coverage 基于 --changed（已提交范围），
# 未提交 TS 改动不在其内，会导致 coverage 产物缺失 → 误报「未找到覆盖率文件」。
# 此处醒目提示，避免误判为代码问题（主模型曾因此误停）。
UNCOMMITTED_TS="$(git diff --name-only HEAD 2>/dev/null | grep -E '\.(ts|tsx|js|jsx)$' || true)"
if [ -n "$UNCOMMITTED_TS" ]; then
  echo "[pre-push] ⚠️  检测到未提交的 TS/JS 改动（${UNCOMMITTED_TS}），diff-coverage 仅审计已 commit 范围。"
  echo "           若门禁报「未找到覆盖率文件」，多为未提交导致，请先 commit 改动再 push。"
fi

# ── 兜底：RANGES 为空（本地已与远端同步）但有未提交改动时，
# 仍纳入工作区 diff，避免「改了 TS 没 commit 就 push」场景下 hook 静默全过。
# （注：此时 git push 本身会因 nothing to push 失败，此处仅让提示更友好、检查更真实）
if [ -z "$CHANGED" ]; then
  CHANGED="$(git diff --name-only HEAD 2>/dev/null || true)"
fi

# ── 缓存工具函数（基于 domain-map.mjs）────────────────────────
# 用法: cache_lookup <domain> <files...> → 输出 "hit" 或 "miss"
# 命中时自动跳过对应检查并输出提示
cache_lookup() {
  local domain="$1"
  shift
  local files="$@"
  
  # 生成缓存键
  local cache_key
  cache_key="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-key "$domain" $files 2>/dev/null)" || return 1
  
  # 生成缓存路径
  local cache_file
  cache_file="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$cache_key" 2>/dev/null)" || return 1
  
  # 检查缓存文件是否存在且未过期（24h TTL 由脚本内部管理）
  if [ -f "$cache_file" ]; then
    echo "hit"
    return 0
  else
    echo "miss"
    return 0
  fi
}

# 写入缓存（检查成功后调用）
cache_write() {
  local domain="$1"
  local files="$2"
  local result="$3"
  
  local cache_key
  cache_key="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-key "$domain" $files 2>/dev/null)" || return 1
  
  local cache_file
  cache_file="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$cache_key" 2>/dev/null)" || return 1
  
  # 写入缓存（仅成功结果缓存，失败不缓存以便重试）
  if [ "$result" = "pass" ]; then
    cd "$ROOT" && node --input-type=module -e "
      import { writeCache } from './scripts/domain-map.mjs';
      writeCache('$cache_key', '$result');
    " 2>/dev/null || true
  fi
}

# ── 判断变更域（粗粒度：向后兼容 GO_CHANGED / TS_CHANGED / DOCS_ONLY）──
# 同时调用 domain-map.mjs 获取细粒度分类 JSON（DOMAINS），供 Phase 2 分流决策使用。
GO_CHANGED=false
TS_CHANGED=false
DOCS_ONLY=false

if [ -n "$CHANGED" ]; then
  if echo "$CHANGED" | grep -qE '\.go$'; then
    if echo "$CHANGED" | grep -vE '(build/|_test\.go$)' | grep -qE '\.go$'; then
      GO_CHANGED=true
    fi
  fi
  if echo "$CHANGED" | grep -qE '\.(ts|tsx|js|jsx)$'; then
    TS_CHANGED=true
  fi
  if echo "$CHANGED" | grep -qvE '^(docs/|.*\.md$|AGENTS\.md)'; then
    DOCS_ONLY=false
  else
    DOCS_ONLY=true
  fi
fi

# ── 细粒度分流：调用 domain-map.mjs 解析变更文件领域分布 ──
# 输出格式：{"docs":false,"frontend":true,"go":false,"infra":false,"mixed":false}
# 若 node 不可用则兜底为空 JSON，所有检查照常运行（fail-safe）
DOMAINS='{}'
DOMAINS_NODE_CMD="cd \"\$ROOT\" && node scripts/domain-map.mjs"
if [ -n "$CHANGED" ] && command -v node >/dev/null 2>&1; then
  # 将 CHANGED 每行作为独立参数传入（避免 bash 管道性能问题）
  _dm_args=""
  while IFS= read -r _f; do
    [ -n "$_f" ] && _dm_args="$_dm_args \"$_f\""
  done <<EOF
$CHANGED
EOF
  _dm_out="$($DOMAINS_NODE_CMD $_dm_args 2>/dev/null)" || _dm_out=""
  # 校验输出是否为合法 JSON（以 { 开头、} 结尾），否则兜底
  case "$_dm_out" in
    '{'*) case "$_dm_out" in *'}') DOMAINS="$_dm_out" ;; esac ;;
  esac
  unset _dm_args _dm_out
fi
# 辅助函数：从 DOMAINS JSON 提取布尔值（jq 不可用时用 grep 兜底）
_dm_bool() {
  # 用法: _dm_bool key → 输出 "true" 或 "false"
  local _k="$1"
  if command -v jq >/dev/null 2>&1; then
    echo "$DOMAINS" | jq -r ".${_k}" 2>/dev/null || echo "false"
  else
    echo "$DOMAINS" | grep -oE "\"${_k}\":[[:space:]]*(true|false)" | grep -oE '(true|false)' || echo "false"
  fi
}
DOM_DOCS="$(_dm_bool docs)"
DOM_FRONTEND="$(_dm_bool frontend)"
DOM_GO="$(_dm_bool go)"
DOM_INFRA="$(_dm_bool infra)"
DOM_MIXED="$(_dm_bool mixed)"
unset _dm_bool

# ── 纯 infra 变更快速放行（.github/ 或 *.yml） ──
# [2026-08-12] 改 CI 工作流/*.yml 不碰源码、文档、ADR，全量生成类门禁
# （funcmap/docsindex/lint/vitest/deadcode 等）无意义且拖慢 push + 吃满单核。
# 此处直接放行，由 push 后 CI（scripts-hygiene / lint / test）兜底。
# 注：仅当变更全部落在 .github/ 或 .yml/.yaml 时短路；改动任一源码/文档仍走全量。
INFRA_ONLY=false
if [ -n "$CHANGED" ]; then
  if echo "$CHANGED" | grep -qvE '^(\.github/|.*\.(yml|yaml)$)'; then
    INFRA_ONLY=false
  else
    INFRA_ONLY=true
  fi
fi
if [ "$INFRA_ONLY" = "true" ]; then
  echo ""
  echo "════════ [pre-push] 结论摘要 ════════"
  echo "  纯 GitHub Actions / YAML 配置变更，跳过源码与文档门禁（CI 兜底）"
  echo "════════════════════════════════════"
  echo "[pre-push] ✅ 全部通过"
  exit 0
fi

# ── P6: bindings 同步性（Go 变动时检查；不可自动修复） ──
# 实跑 generate:bindings 对比工作区：
#   - 生成结果与当前一致（含"Go 改了但 bindings 内容恰好没变"的合法场景）→ 放行
#   - 生成结果有 diff（bindings 过期）→ 阻断，提示用户 amend
if [ "$GO_CHANGED" = "true" ]; then
  echo "[pre-push] check:bindings（实跑 generate:bindings 验证同步性）"
  if [ ! -d "$ROOT/frontend/bindings" ] || [ -z "$(ls -A "$ROOT/frontend/bindings" 2>/dev/null)" ]; then
    echo "❌ frontend/bindings/ 为空。请运行: cd frontend && npm run generate:bindings"
    collect_fail "frontend/bindings/ 为空: 运行 cd frontend && npm run generate:bindings 生成绑定后重推"
  fi
  if ! (cd "$ROOT/frontend" && npm run generate:bindings >/dev/null 2>&1); then
    echo "❌ generate:bindings 执行失败。请检查 Go 代码是否能编译。"
    echo "   手动运行: cd frontend && npm run generate:bindings 查看错误"
    collect_fail "generate:bindings 执行失败: 检查 Go 编译错误 cd frontend && npm run generate:bindings"
  fi
  if ! git diff --quiet -- frontend/bindings/ 2>/dev/null; then
    echo "❌ Go 文件已变更但 frontend/bindings/ 未同步。"
    echo "   hook 已运行 generate:bindings 生成最新版本，请检查 diff 后 amend："
    echo "     git add frontend/bindings/ && git commit --amend --no-edit"
    collect_fail "Go 变更但 frontend/bindings/ 未同步: git add frontend/bindings/ && git commit --amend --no-edit，再重推"
  fi
  note_check "✅ check:bindings 同步性"
fi

# ── 文档生成物检查分流决策（细粒度 Phase 2） ──
# 纯 Go 或纯 frontend 变更时跳过全部文档生成物（status/funcmap/docsindex/novelindex/menumap/guide-gap），
# 因为这类变更不触碰 docs/ 索引，跑起来是无效算力消耗。
# DOCS_ONLY 或 mixed（含 docs 领域）场景仍需运行。
_NEED_DOCS_GEN=true
if [ "$DOCS_ONLY" = "false" ]; then
  if [ "$DOM_FRONTEND" = "true" ] && [ "$DOM_DOCS" = "false" ] && [ "$DOM_GO" = "false" ]; then
    # 纯 frontend → 跳过所有文档生成物
    _NEED_DOCS_GEN=false
  elif [ "$DOM_GO" = "true" ] && [ "$DOM_DOCS" = "false" ] && [ "$DOM_FRONTEND" = "false" ]; then
    # 纯 Go → 跳过所有文档生成物（bindings 在下方单独处理）
    _NEED_DOCS_GEN=false
  fi
fi
unset DOM_DOCS DOM_FRONTEND DOM_GO DOM_MIXED

# ── check:status（可自动修复，amend 进当前 commit） ──
# 成功静默（末尾摘要已聚合状态），仅未同步/修复时输出
_check_status() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:status（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:status（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:status"
  cd "$ROOT" && node scripts/gen-status-index.mjs --reverse --check >/dev/null 2>&1 || {
    echo "⚠️  status.md 未同步，自动修复中..."
    cd "$ROOT" && node scripts/gen-status-index.mjs --reverse
    git add docs/status.md 2>/dev/null || true
    git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新 docs/status.md 并 amend 进当前 commit。" || echo "⚠️  已 stage docs/status.md（无 HEAD 可 amend，请手动 commit）。"
    _par_note_fixed "status.md 已同步"
  }
  _par_note_check "✅ check:status 索引同步"
}

# ── check:funcmap（可自动修复，amend 进当前 commit） ──
_check_funcmap() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:funcmap（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:funcmap（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:funcmap"
  cd "$ROOT" && node scripts/gen-funcmap.mjs --check >/dev/null 2>&1 || {
    echo "⚠️  function-map.md 未同步，自动修复中..."
    cd "$ROOT" && node scripts/gen-funcmap.mjs
    git add docs/function-map.md 2>/dev/null || true
    git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新 docs/function-map.md 并 amend 进当前 commit。" || echo "⚠️  已 stage docs/function-map.md（无 HEAD 可 amend，请手动 commit）。"
    _par_note_fixed "function-map.md 已同步"
  }
  _par_note_check "✅ check:funcmap 已同步"
}

# ── check:docsindex（可自动修复，amend 进当前 commit） ──
_check_docsindex() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:docsindex（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:docsindex（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:docsindex"
  cd "$ROOT" && node scripts/gen-docs-index.mjs --check >/dev/null 2>&1 || {
    echo "⚠️  分区索引（guide/adr/knowledge/buglog/releases）未同步，自动修复中..."
    cd "$ROOT" && node scripts/gen-docs-index.mjs
    git add docs/guide/index.md docs/adr/index.md docs/knowledge/index.md docs/buglog/index.md docs/releases/index.md 2>/dev/null || true
    git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新分区索引并 amend 进当前 commit。" || echo "⚠️  已 stage 分区索引（无 HEAD 可 amend，请手动 commit）。"
    _par_note_fixed "分区索引已同步"
  }
  _par_note_check "✅ check:docsindex 分区索引同步"
}

# ── check:novelindex（可自动修复，amend 进当前 commit） ──
_check_novelindex() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:novelindex（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:novelindex（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:novelindex"
  if cd "$ROOT" && node scripts/gen-novel-index.mjs --check >/dev/null 2>&1; then
    _par_note_check "✅ check:novelindex 小说索引同步"
  else
    echo "⚠️  小说章节索引（docs/novel/index.md）未同步，自动修复中..."
    cd "$ROOT" && node scripts/gen-novel-index.mjs
    git add docs/novel/index.md 2>/dev/null || true
    git commit --amend --no-edit 2>/dev/null && echo "⚠️  已自动更新小说索引并 amend 进当前 commit。" || echo "⚠️  已 stage 小说索引（无 HEAD 可 amend，请手动 commit）。"
    _par_note_fixed "小说索引已同步"
  fi
}

# ── check:guide-gap（菜单面板 ↔ 指南覆盖缺口；人工补写，不可自动修复） ──
_check_guide_gap() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:guide-gap（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:guide-gap（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:guide-gap（缺口即阻断）"
  if ! cd "$ROOT" && node scripts/gen-guide-gap.mjs --strict >/dev/null 2>&1; then
    echo "❌ 菜单面板存在 guide 覆盖缺口，需人工补写指南页。详情："
    cd "$ROOT" && node scripts/gen-guide-gap.mjs --strict 2>&1 | tail -15
    _par_collect_fail "菜单面板存在 guide 覆盖缺口" "按上方详情补写对应指南页后重推"
  fi
  _par_note_check "✅ check:guide-gap（guide 全覆盖）"
}

# ── check:menumap（可自动修复，amend 进当前 commit） ──
_check_menumap() {
  if [ "$_NEED_DOCS_GEN" != "true" ]; then
    echo "[pre-push] check:menumap（跳过：纯 Go/frontend 变更，无需索引同步）"
    _par_note_check "⏭️ check:menumap（文档生成物跳过）"
    return 0
  fi
  echo "[pre-push] check:menumap"
  cd "$ROOT" && node scripts/gen-menu-map.mjs --check >/dev/null 2>&1 || {
    echo "⚠️  menu-map.md 未同步，自动修复中..."
