# ── tsc 类型检查（TS 变更时触发 + 缓存） ──
# [ADR-258] 类型安全是项目底线，3s 成本 vs 20 倍修复成本差
# 缓存：tsconfig.json + 所有 frontend/src/**/*.ts 的哈希作为键
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  # 生成 tsc 缓存键（包含 tsconfig + 所有 TS 文件）
  TSC_CACHE_KEY="$(cd "$ROOT" && node -e "
    const crypto = require('crypto');
    const fs = require('fs');
    const path = require('path');
    const hash = crypto.createHash('md5');
    // 包含 tsconfig.json
    hash.update(fs.readFileSync('frontend/tsconfig.json', 'utf-8'));
    // 包含所有 frontend/src/**/*.ts 的**内容**哈希（路径+内容）
    function walkDir(dir) {
      fs.readdirSync(dir).forEach(f => {
        const full = path.join(dir, f);
        if (fs.statSync(full).isDirectory()) walkDir(full);
        else if (/\.(ts|tsx)$/.test(f)) {
          // [fix:ADR-258] 必须 hash 内容，否则修改文件内容不会使缓存失效
          hash.update(fs.readFileSync(full, 'utf-8'));
        }
      });
    }
    walkDir('frontend/src');
    console.log(hash.digest('hex'));
  " 2>/dev/null)" || TSC_CACHE_KEY=""
  
  _TSC_CACHE_FILE=""
  if [ -n "$TSC_CACHE_KEY" ]; then
    _TSC_CACHE_FILE="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$TSC_CACHE_KEY" 2>/dev/null)" || _TSC_CACHE_FILE=""
  fi
  
  _TSC_CACHE_HIT=false
  if [ -n "$_TSC_CACHE_FILE" ] && [ -f "$_TSC_CACHE_FILE" ]; then
    _TSC_CACHE_HIT=true
  fi
  
  if [ "$_TSC_CACHE_HIT" = "true" ]; then
    echo "[pre-push] tsc（缓存命中，跳过）"
    note_check "⏭️ tsc（缓存命中）"
  else
    echo "[pre-push] tsc（类型检查，~3s）"
    TSC_OUT="$(cd "$ROOT/frontend" && npx tsc --noEmit 2>&1)" || {
      printf '%s\n' "$TSC_OUT" | tail -20
      collect_fail "tsc 类型错误: 修复上方错误后重推"
    }
    note_check "✅ tsc 类型检查"
    # 写入缓存（仅成功时）
    if [ -n "$TSC_CACHE_KEY" ] && [ -n "$_TSC_CACHE_FILE" ]; then
      cd "$ROOT" && node --input-type=module -e "
        import { writeCache } from './scripts/domain-map.mjs';
        writeCache('$TSC_CACHE_KEY', 'pass');
      " 2>/dev/null || true
    fi
  fi
else
  note_check "⏭️ tsc（未涉及 TS 或 npm 不可用）"
fi

# ── test:coverage（仅 TS/JS 变更时；不可自动修复 + 缓存） ──
# 纯 Go 变更有 Go 测试覆盖，纯文档变更无逻辑可测，均跳过前端测试
# npm 不可用时跳过；成功静默（coverage summary 大表由 CI 门禁兜底），失败时打印失败测试明细 + 覆盖率差距
# [2026-08-10] 全量 test:coverage（~66s）→ `vitest run --changed <base>` 只跑
# 本次推送变更影响的测试（秒级）：base 取推送 RANGE 的远端 SHA（对象缺失时
# 回退 origin/main）。纯配置/CI 变更 0 测试命中（vitest exit 0 且不产 coverage
# 产物）→ 跳过 diff-coverage；整体覆盖率回退由 CI 每日 schedule 兜底。
# 缓存：测试文件 + 被测文件哈希作为键
if [ "$TS_CHANGED" = "true" ] && [ "$NPM_AVAILABLE" = "true" ]; then
  # 取第一个可解析的 RANGE base（remote_sha）；git 对象缺失时回退 origin/main
  CHANGED_BASE=""
  for r in $RANGES; do
    base="${r%%..*}"
    if git cat-file -e "$base" 2>/dev/null; then
      CHANGED_BASE="$base"
      break
    fi
  done
  [ -z "$CHANGED_BASE" ] && CHANGED_BASE="origin/main"
  
  # 生成 vitest 缓存键（包含测试文件和被测文件）
  VITEST_CACHE_KEY="$(cd "$ROOT" && node -e "
    const crypto = require('crypto');
    const fs = require('fs');
    const path = require('path');
    const hash = crypto.createHash('md5');
    hash.update('$CHANGED_BASE');
    // 收集变更的测试文件和源文件
    const changedFiles = \`$CHANGED\`.split('\n').filter(f => /\\.(ts|tsx|js|jsx)$/.test(f));
    changedFiles.forEach(f => hash.update(f.trim()));
    console.log(hash.digest('hex'));
  " 2>/dev/null)" || VITEST_CACHE_KEY=""
  
  _VITEST_CACHE_FILE=""
  if [ -n "$VITEST_CACHE_KEY" ]; then
    _VITEST_CACHE_FILE="$(cd "$ROOT" && node scripts/domain-map.mjs --cache-path "$VITEST_CACHE_KEY" 2>/dev/null)" || _VITEST_CACHE_FILE=""
  fi
  
  _VITEST_CACHE_HIT=false
  if [ -n "$_VITEST_CACHE_FILE" ] && [ -f "$_VITEST_CACHE_FILE" ]; then
    _VITEST_CACHE_HIT=true
  fi
  
  if [ "$_VITEST_CACHE_HIT" = "true" ]; then
    echo "[pre-push] vitest --changed $CHANGED_BASE（缓存命中，跳过）"
    note_check "⏭️ vitest --changed（缓存命中）"
  else
    echo "[pre-push] vitest --changed $CHANGED_BASE（只跑受影响测试 + coverage，替代全量 ~66s；可用 git push --no-verify 跳过，不推荐）"
    COV_LOG="$(mktemp -t pre-push-cov.XXXXXX 2>/dev/null || echo "$ROOT/.pre-push-cov.log")"
    cd "$ROOT/frontend"
    # [fix:2026-08] --changed 只跑受影响测试，coverage 必然 < 全量阈值；
    # 用 0 阈值关闭全局门槛（diff-coverage 才是新代码 ≥60% 的守卫）。
    if npx vitest run --changed "$CHANGED_BASE" --coverage --coverage.clean=false \
        --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 \
        --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 >"$COV_LOG" 2>&1; then
      # P8-A: 新代码保护——本次变更源码的行覆盖率 ≥60%（复用 test:coverage 生成的 coverage-final.json）
      # 整体阈值 35% 只防「覆盖率回退」，不保护「新代码有测试」；diff-coverage 补上后者（vitest.config.ts 注释）
      # 判据用日志中的 "Test Files"（有测试实际运行）而非产物文件：--changed 0 命中时
      # --coverage.clean=false 会残留旧 coverage-final.json，直接查文件会拿过期产物误判。
      if grep -q "Test Files" "$COV_LOG"; then
        # [fix:win] 临时日志清理容错：部分 Windows 环境（WorkBuddy safe-delete 层 /
        # genie-trash）包装 rm 后对 /tmp 相对路径处理失败返回非零，set -e 下会中断
        # hook（2026-08-05 v1.9.1 发版实证）。清理失败仅遗留垃圾文件，不影响正确性。
        # [2026-10-23 fix] 先取摘要再删日志：原顺序是先 rm 再 grep 同一文件，
        # 导致摘要恒为空，还会打出 "grep: /tmp/pre-push-cov.xxx: No such file or directory"。
        _VITEST_LINE="$(grep -oE '[0-9]+ tests' "$COV_LOG" | head -1 || true)"
        rm -f "$COV_LOG" 2>/dev/null || true
        note_check "✅ vitest --changed（${_VITEST_LINE:-有命中}）"
        echo "[pre-push] diff-coverage（新代码保护: 变更行 ≥60%，失败阻断推送）"
        if npm run test:diff-coverage >"$COV_LOG" 2>&1; then
          # [fix:win] 临时日志清理容错：部分 Windows 环境（WorkBuddy safe-delete 层 /
          # genie-trash）包装 rm 后对 /tmp 相对路径处理失败返回非零，set -e 下会中断
          # hook（2026-08-05 v1.9.1 发版实证）。清理失败仅遗留垃圾文件，不影响正确性。
          rm -f "$COV_LOG" 2>/dev/null || true
          note_check "✅ diff-coverage"
          # 写入缓存
          if [ -n "$VITEST_CACHE_KEY" ] && [ -n "$_VITEST_CACHE_FILE" ]; then
            cd "$ROOT" && node --input-type=module -e "
              import { writeCache } from './scripts/domain-map.mjs';
              writeCache('$VITEST_CACHE_KEY', 'pass');
            " 2>/dev/null || true
          fi
        else
          echo "⚠️  diff-coverage 提示：本次变更源码覆盖率不足 60%。明细："
          grep -E "\[X\]|失败|低于|覆盖" "$COV_LOG" | head -15
          # [fix:win] 临时日志清理容错：部分 Windows 环境（WorkBuddy safe-delete 层 /
          # genie-trash）包装 rm 后对 /tmp 相对路径处理失败返回非零，set -e 下会中断
          # hook（2026-08-05 v1.9.1 发版实证）。清理失败仅遗留垃圾文件，不影响正确性。
          rm -f "$COV_LOG" 2>/dev/null || true
          # [round80 P1-②] 按脚本头契约真正阻断：check-diff-coverage 头注释写的是
          # 「阻断模式：低于阈值 exit 1 拦 push」，且 exit 2 表示 git/配置异常应终止。
          # 原实现只用 note_check 记录 → 非零退出被吞成一条⏭️，门禁形同虚设。
          collect_fail "diff-coverage 失败: 本次变更源码的变更行覆盖率不足 60%（补测试后重推；确为历史遗留债请记录到 ADR-254 而非 --no-verify 绕过）"
        fi
      else
        rm -f "$COV_LOG" 2>/dev/null || true
        echo "[pre-push] 无受影响测试（纯配置/CI/文档变更），跳过 diff-coverage"
        note_check "⏭️ vitest --changed（0 测试命中）"
      fi
    else
      echo "❌ vitest --changed 失败。明细如下："
      echo "── 失败测试 ──"
      grep -E "×|✗|FAIL" "$COV_LOG" | head -20
      echo "── 覆盖率阈值 ──"
      grep -E "does not meet|threshold|Coverage for" "$COV_LOG" | head -8
      echo "── 汇总 ──"
      grep -E "Test Files|Tests " "$COV_LOG" | head -4
      # [fix:win] 临时日志清理容错：部分 Windows 环境（WorkBuddy safe-delete 层 /
      # genie-trash）包装 rm 后对 /tmp 相对路径处理失败返回非零，set -e 下会中断
      # hook（2026-08-05 v1.9.1 发版实证）。清理失败仅遗留垃圾文件，不影响正确性。
      rm -f "$COV_LOG" 2>/dev/null || true
      collect_fail "vitest --changed 失败: 修复上方失败测试/覆盖率阈值后重推（详情见上方明细，或手动运行: cd frontend && npx vitest run --changed $CHANGED_BASE --coverage）"
    fi
  fi
else
  if [ "$TS_CHANGED" = "true" ]; then
    note_check "⏭️ test:coverage（npm 不可用 → $NPM_SKIP_REASON）"
  else
    note_check "⏭️ test:coverage（未涉及 TS 或 npm 不可用）"
  fi
fi

