}

# ── link:check（JS 严格门禁；依赖 npm，须 NPM_AVAILABLE 守卫） ──
_check_link() {
  if [ "$NPM_AVAILABLE" != "true" ]; then
    echo "[pre-push] link:check（跳过：$NPM_SKIP_REASON）"
    _par_note_check "⏭️ link:check（npm 不可用 → $NPM_SKIP_REASON）"
    return 0
  fi
  echo "[pre-push] link:check（JS strict 门禁）"
  cd "$ROOT" && npm run link:check >/dev/null 2>&1 || {
    echo "❌ Markdown 断链（link:check --strict）："
    cd "$ROOT" && npm run link:check 2>&1 | grep -E "broken|❌|✗" | head -15
    _par_collect_fail "Markdown 断链" "修复 docs/ 下的断链（相对链接目标不存在），重跑 npm run link:check 验证后重推"
  }
  _par_note_check "✅ link:check（JS strict 门禁）"
}

# ── 组 C：独立检查（并行执行） ──
# check:docs / i18n / check:md-links / link:check 完全独立，无状态共享
_par_init
_check_docs &
_pid_c1=$!
_check_i18n &
_pid_c2=$!
_check_md_links &
_pid_c3=$!
_check_link &
_pid_c4=$!
_parallel_wait $_pid_c1 $_pid_c2 $_pid_c3 $_pid_c4 || true
_par_merge
_par_cleanup

# ── 最终结论（所有检查跑完后统一报告，避免 AI 只看到第一个错误） ──
finalize_results
