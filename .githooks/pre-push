#   - link:check：1131 篇 md 全量断链，CI 的 config-syntax job 已经跑
_PAR_DIR="$(mktemp -d 2>/dev/null || echo "/tmp/pre-push-par.$$")"
mkdir -p "$_PAR_DIR" 2>/dev/null || true
: > "$_PAR_DIR/checks" && : > "$_PAR_DIR/fails" && : > "$_PAR_DIR/fixed"
ALL_PIDS=""
_check_docs & ALL_PIDS="$ALL_PIDS $!"
_check_i18n & ALL_PIDS="$ALL_PIDS $!"

_parallel_wait $ALL_PIDS || true
_par_merge_dir "$_PAR_DIR"
rm -rf "$_PAR_DIR" 2>/dev/null || true

# ── 最终结论（所有检查跑完后统一报告，避免 AI 只看到第一个错误） ──
finalize_results
