{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "postinstall": "node scripts/apply-vendored-wasm.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "vite build",
    "check": "tsc --noEmit",
    "check:i18n": "node ../scripts/i18n-check.mjs --strict",
    "gen:icons": "node ../scripts/gen-icon-bundle.mjs",
    "check:icons": "node ../scripts/gen-icon-bundle.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:int": "vitest run .int.test",
    "test:warm": "vitest run src/__tests__/goerr.test.ts --no-color",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:diff-coverage": "node ../scripts/check-diff-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dom": "playwright test --grep @dom",
    "test:e2e:webgl": "playwright test --grep @webgl",
    "test:e2e:web": "playwright test --grep @web",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json,md}\"",
    "generate:bindings": "cd .. && wails3 generate bindings -ts -i -d frontend/bindings ./...",
    "audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "outdated": "npm outdated",
    "deadcode": "knip",
    "deadcode:strict": "knip --production",
    "deadcode:baseline": "node ../scripts/check-deadcode-baseline.mjs",
    "duplicate": "jscpd --config jscpd.config.json src",
    "duplicate:html": "jscpd --config jscpd.config.json --output jscpd-report --reporters jscpd-html-reporter src",
    "analyze:bundle": "vite build --mode production"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "@iconify/icons-lucide": "^1.2.135",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "jscpd": "^5.0.12",
    "jscpd-html-reporter": "^2.0.1",
    "knip": "^6.29.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^5.13.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@babylonjs/core": "^9.16.1",
    "@babylonjs/loaders": "^9.16.1",
    "@babylonjs/materials": "^9.16.1",
    "@iconify/iconify": "^3.1.1",
    "@preact/signals-core": "^1.14.4",
    "@wailsio/runtime": "^3.0.0-alpha.95",
    "babylon-mmd": "^1.2.0",
    "encoding-japanese": "^2.2.0",
    "fflate": "^0.8.3",
    "iconify-icon": "^3.0.2"
  }
}
